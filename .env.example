PATH="path to the folder where this repo is cloned"
# Discord
DISCORD_TOKEN="your discord token"
DISCORD_OWNER_ID="your discord id"
DISCORD_APP_ID="the discord id of your app"
DISCORD_CLIENT_ID="${DISCORD_APP_ID}"
DISCORD_PUBLIC_KEY="the public key of your app"
DISCORD_INVITE_BOT="link to invite your bot"
DISCORD_INVITE_SERVER="link to your support"
DISCORD_SUPPORT_QR="qr code to link your support"

# World of Warships
WOWS_TOKEN="your wows api token"

# Twitch
TWITCH_ID="id of your twitch app"
TWITCH_SECRET="secret of your twitch app"

# GitHub
GITHUB_REPO=https://github.com/HenriGolo/GoloBot/

# Logs
LOGS_STDOUT=logs/dev.log
LOGS_STDERR=logs/error.log
LOGS_DM=logs/dm.log

# DB
# Settings
DB_SETTINGS=Data/settings.json
# Annonces Streams
DB_STREAMS=Data/annonces_streams.json
# Questions Pour Un Poulet
DB_QPUP=Data/qpup.json

# Message d'erreur
ERROR_MSG="Une erreur est survenue ..."
